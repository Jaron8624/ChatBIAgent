# ===== 大模型配置 =====
# DashScope API Key（必填，从阿里云灵积平台获取）
DASHSCOPE_API_KEY=your_dashscope_api_key

# API 基础地址（DashScope 兼容 OpenAI 格式）
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Agent 主模型（推荐 qwen-plus，平衡性能与成本）
AGENT_BASE_MODEL=qwen3.5-flash-2026-02-23

# 记忆提取模型（后台任务使用，建议用小模型节省成本）
SUMMARIZATION_MODEL=qwen-turbo

# ===== 嵌入模型配置 =====
# Embedding Provider: siliconflow | dashscope | ollama | openai_compatible
EMBEDDING_PROVIDER=siliconflow
# 文本向量化模型（用于知识库和记忆的语义检索）
EMBEDDING_MODEL=BAAI/bge-m3
# Embedding API Key（SiliconFlow: https://siliconflow.cn 获取；ollama 留空）
EMBEDDING_API_KEY=your_embedding_api_key
# Embedding 服务地址（留空使用 provider 默认值）
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=10

# 向量维度（bge-m3 / text-embedding-v4 均为 1024 维）
dense_dimension=1024

# ===== Rerank 重排序配置 =====
# Rerank Provider: dashscope | siliconflow
RERANK_PROVIDER=siliconflow
# 重排序模型（用于优化检索结果的相关性排序）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Rerank API Key（留空回退到 EMBEDDING_API_KEY / DASHSCOPE_API_KEY）
RERANK_API_KEY=
# 重排序 API 地址
RERANK_URL=https://api.siliconflow.cn/v1/rerank


# ===== Milvus 向量数据库配置 =====
# Zilliz Cloud 服务地址（或自建 Milvus 地址）
Milvus_url=your_milvus_url

# 认证 Token（Zilliz Cloud 格式：username:password）
Token=your_milvus_token

# 知识库集合名称
knowledge_base_collection=knowledge_base_collection

# 记忆集合名称
memory_collection=memory_collection
MEMORY_MIN_RELEVANCE=0.35
MEMORY_EXTRACT_TOKEN_THRESHOLD=1000
MEMORY_EXTRACT_IDLE_SECONDS=900

# ===== PostgreSQL 数据库配置 =====
# 完整连接字符串（包含用户名、密码、主机、端口、数据库名）
DATABASE_URL=postgresql://user:pass@localhost:5432/echomind_db?sslmode=disable
# Harness 的版本化数据集、实验、分数、门禁和审计记录。生产环境使用 PostgreSQL。
HARNESS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/echomind_db

# 分项配置（用于程序自动创建数据库）
user=your_db_user
password=your_db_password
host=localhost
port=5432
db_name=echomind_db

# ===== Redis 配置 =====
# Redis 连接地址（用于对话检查点存储和用户画像缓存）
REDIS_URL=redis://localhost:6379/0

# ===== 临时文件目录 =====
# 文档上传后的临时存储路径
TEMP_DIR=/tmp

# ===== 多 Agent 编排配置 =====
# 编排器最大重试次数（ reflection 失败后重试上限）
ORCHESTRATOR_MAX_RETRIES=2

# ===== MCP 工具协议配置 =====
# MCP 服务端监听端口（内部 JSON-RPC 2.0 通信）
MCP_SERVER_PORT=8765
# MCP 调用超时（秒）
MCP_CALL_TIMEOUT=30

# ===== Monitor 闭环监控配置 =====
# 滑动窗口最大记录数
MONITOR_WINDOW_SIZE=1000
# 滑动窗口时间跨度（秒）
MONITOR_WINDOW_SECONDS=300
# 成功率阈值，低于此值触发权重下调（0~1）
MONITOR_SUCCESS_RATE_THRESHOLD=0.95
# P99 延迟阈值（毫秒），超过触发权重下调
MONITOR_P99_THRESHOLD_MS=3000
# P99 严重阈值（毫秒），超过后权重降至最低
MONITOR_P99_CRITICAL_MS=5000

# ===== LLM-as-Judge 评测配置 =====
# 评测及格线（overall_score >= 此值视为通过）
EVALUATION_PASS_THRESHOLD=6.0
# Bad Case 库最大容量
EVALUATION_MAX_BAD_CASES=1000
# 评测模型（可用轻量模型降低成本）
EVALUATION_MODEL=qwen-turbo

# ===== 查询改写配置 =====
# 改写时参考的最大历史轮数
QUERY_REWRITE_MAX_HISTORY=6

# ===== 权限控制（ACL）配置 =====
# 审计日志最大保留条数
ACL_MAX_AUDIT_LOGS=5000
# 仅本地演示时可显式启用客户端角色头；部署环境应由认证中间件提供 request.state.user
NEXUSMIND_ALLOW_HEADER_IDENTITY=false
# 允许跨域访问 API 的前端源，以逗号分隔；部署时替换为实际前端域名
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Skills 管理配置 =====
# Skills 持久化目录
SKILLS_DIR=./skills

# ===== 自进化机制配置 =====
# 进化规则持久化目录
EVOLUTION_DIR=./evolution

# ===== 会话恢复配置 =====
# 单会话最大 Token 数（超过触发压缩）
SESSION_MAX_TOKENS=8000
# 会话压缩阈值
SESSION_COMPRESS_THRESHOLD=6000
# 会话 TTL（秒）
SESSION_TTL_SECONDS=86400
# 图执行持久化。auto 表示配置加密密钥时启用；生产环境建议显式设为 true。
GRAPH_CHECKPOINT_ENABLED=auto
# PostgreSQL LangGraph Checkpointer 的加密密钥。必须使用 Fernet 密钥，并通过密钥管理服务注入。
GRAPH_CHECKPOINT_FERNET_KEY=
# 图检查点空闲保留时间，超期由后台任务清理。
GRAPH_CHECKPOINT_TTL_DAYS=30
# 已完成的用户对话是否写入 PostgreSQL，供后台长期记忆提取任务使用。
LONG_TERM_MEMORY_INGEST_ENABLED=true
# 长期记忆的可选有效期，0 表示不过期。
LONG_TERM_MEMORY_TTL_DAYS=0
# 原文存档加密密钥。必须在密钥管理服务中生成并注入；未配置时拒绝明文存档。
# 生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTEXT_STORE_FERNET_KEY=
# 回答合成阶段的输入估算预算，需按部署模型的真实窗口留足输出空间
SYNTHESIS_INPUT_BUDGET=12000
SYNTHESIS_CONTEXT_WINDOW_TOKENS=16384
SYNTHESIS_OUTPUT_TOKENS=2048

# ===== MCP 外部 Server 配置 =====
# 外部 MCP Server 列表（格式：name:command:arg1,arg2;name2:url:https://...）
# 示例：MCP_SERVERS=filesystem:npx:@modelcontextprotocol/server-filesystem;github:npx:@modelcontextprotocol/server-github
MCP_SERVERS=
# ===== 自进化自动触发闭环 =====
# 是否启用自进化后台任务（BadCase → 规则抽取 → 自动决策）
EVOLUTION_LOOP_ENABLED=true
# 轮询间隔（秒），默认 300 = 5 分钟
EVOLUTION_LOOP_INTERVAL=300
# 自动接受阈值（规则置信度 >= 此值自动 accept，0 表示禁用自动接受、全部人工评审）
EVOLUTION_AUTO_ACCEPT=0.85
# 高置信度只代表进入候选区，不能直接生效。正式生效必须通过 Harness Gate 和显式晋升。
# 每轮最多处理的 BadCase 数量
EVOLUTION_BATCH_LIMIT=10

# ===== Harness 发布门禁 =====
HARNESS_MAX_QUALITY_DROP=0
HARNESS_MAX_LATENCY_RATIO=1.15
HARNESS_MAX_COST_RATIO=1.20
# true 时，供应商没有返回 Token / 成本用量就阻止晋升，避免把未知当成零
HARNESS_REQUIRE_USAGE_METRICS=true
HARNESS_CASE_TIMEOUT_SECONDS=180
HARNESS_CONCURRENCY=2
# true 时，工作区存在未提交修改会阻断晋升。开发环境可保持 false，CI 建议设为 true。
HARNESS_REQUIRE_CLEAN_GIT=false
# 固定实验随机种子，保证重复运行可以回放
HARNESS_SEED=20260923
# 安全保护集的最低通过率
HARNESS_SECURITY_PASS_RATE=1.0
# 可选，设置后要求 holdout 集达到该通过率
# HARNESS_HOLDOUT_PASS_RATE=1.0
# 评测模型价格，单位为 USD / 1000 tokens。缺失时用量 Gate 拒绝晋升。
LLM_INPUT_USD_PER_1K=
LLM_OUTPUT_USD_PER_1K=
LLM_PRICING_VERSION=
# Harness 发布权限。键为角色，值为权限数组。生产环境建议由平台配置覆盖。
HARNESS_RBAC_ROLES={"system":["admin","approve","release","rollback","observe"],"evolution":["approve","observe"],"ops":["release","rollback","observe"],"runtime":["observe","rollback"],"viewer":["observe"]}
# 灰度期间的默认观测阈值
HARNESS_CANARY_MIN_QUALITY=0.8
HARNESS_CANARY_MIN_SAFETY=1.0
HARNESS_CANARY_MAX_P95_MS=5000
HARNESS_CANARY_MIN_SAMPLES=5
# OpenTelemetry OTLP/HTTP。留空时保留本地 OTLP 结构，不发网络请求。
OTEL_SERVICE_NAME=nexusmind-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
